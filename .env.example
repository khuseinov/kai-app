API_BASE_URL=https://<username>-<space>.hf.space
USE_REAL_CHAT=true
# Required when the HF Space is private. Generate at https://huggingface.co/settings/tokens
HF_TOKEN=
# Used by backend admin/health endpoints (/sessions, /user, /health).
INTERNAL_HEALTH_TOKEN=
# Voice gateway base URL and API key (required for voice input/output).
# For HF Space / production, set this to the same public URL as API_BASE_URL
# (or leave it empty) so voice traffic is routed through kai-core's /voice proxy.
# For local development with a directly reachable voice-gateway, use http://localhost:8002.
VOICE_GATEWAY_BASE_URL=http://localhost:8002
VOICE_GATEWAY_API_KEY=
# Voice transport: ws (default, duplex WebSocket) | livekit (WebRTC).
# livekit needs the gateway's LIVEKIT_ENABLED=1; on token 503 the app
# silently falls back to ws.
VOICE_TRANSPORT=ws
