API_BASE_URL=https://<username>-<space>.hf.space
USE_REAL_CHAT=true
# kai-auth service base URL. Set when kai-auth runs on its OWN host (e.g. a
# Render deploy: https://kai-auth-xxx.onrender.com) — sign-in goes there
# directly, and the HF token is NOT sent to it. Leave blank if kai-auth is
# co-located on the HF Space (then it falls back to API_BASE_URL + HF token).
AUTH_BASE_URL=
# Required when the HF Space is private. Generate at https://huggingface.co/settings/tokens
HF_TOKEN=
# APP-AUTH-1 (kai-auth, services/auth/openapi.yaml v0.2.0). Web/server OAuth
# client id from Google Cloud Console — same value must be in kai-auth's
# Rust-side aud allowlist. TODO: founder provisions the Google Cloud project;
# until set, "Войти через Google" throws (GoogleSignIn.initialize with a null
# serverClientId still runs, but kai-auth will reject the token's aud).
GOOGLE_SERVER_CLIENT_ID=
# Optional iOS-specific OAuth client id. Leave blank unless the iOS client
# needs to differ from GOOGLE_SERVER_CLIENT_ID.
GOOGLE_IOS_CLIENT_ID=
# Voice gateway base URL and API key (required for voice input/output).
# For HF Space / production, set this to the same public URL as API_BASE_URL
# (or leave it empty) so voice traffic is routed through kai-core's /voice proxy.
# For local development with a directly reachable voice-gateway, use http://localhost:8002.
VOICE_GATEWAY_BASE_URL=http://localhost:8002
VOICE_GATEWAY_API_KEY=
# Voice transport: ws (default, duplex WebSocket) | livekit (WebRTC).
# livekit needs the gateway's LIVEKIT_ENABLED=1; on token 503 the app
# silently falls back to ws.
VOICE_TRANSPORT=ws
